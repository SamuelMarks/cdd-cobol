# ==============================================================================
# .gitignore — cdd-cobol (Portable ANSI COBOL-85 SDK & CLI, COBOL-60..2023)
# ==============================================================================

# ------------------------------------------------------------------------------
# Project Build, Binary, Staging & Distribution Directories
# ------------------------------------------------------------------------------
/bin/
/build/
/dist/
/out/
/pkg/
/release/
/stage/
/target/

# Packaged release archives & checksums
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.tar.zst
*.zip
*.7z
*.sha256
*.sha512
*.sig
*.asc
SHA256SUMS*
SHA512SUMS*

# ------------------------------------------------------------------------------
# COBOL / GnuCOBOL Compiler, Transpiler & Linker Artifacts
# ------------------------------------------------------------------------------
# Compiled object files, static archives, and shared/dynamic modules
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# COBOL loadable modules, intermediate bytecode, symbols & debug bundles
*.mod
*.int
*.gnt
*.idy
*.stb
*.cob.h
*.exp
*.ilk
*.pdb
*.dSYM/

# GnuCOBOL transpiled C/preprocessor/assembler intermediates (cobc -C / -E / -S)
*.c
*.c.h
*.c.l.h
*.c.l*.h
*.i
*.ii
*.s
*.S

# Compiler listings, cross-reference tables, symbol dumps & linker maps
*.lst
*.lis
*.prn
*.xref
*.sym
*.map
*.dump

# COBOL runtime ISAM / Indexed / Relative file handler artifacts (BDB / VBISAM / LMDB)
*.idx
*.vix
*.dat.idx
*.bdb
*.lck
*.lock
__db.*
log.0000*

# ------------------------------------------------------------------------------
# Code Coverage, Instrumentation & Profiling Artifacts
# ------------------------------------------------------------------------------
# GCC / Clang / GnuCOBOL gcov & llvm-cov outputs
*.gcno
*.gcda
*.gcov
*.profraw
*.profdata
default.profraw

# LCOV & HTML coverage reports
coverage.info
raw.info
lcov.info
coverage/
coverage-html/
htmlcov/

# Self-hosted COBOL instrumenter/probe outputs (when emitted outside build/)
manifest.dat
hits.dat

# Profilers, Valgrind & sanitizers
gmon.out
perf.data
perf.data.old
callgrind.out.*
cachegrind.out.*
massif.out.*
helgrind.out.*
vgcore.*

# ------------------------------------------------------------------------------
# cdd-cobol Runtime, Atomic Write & Test Scratch Files
# ------------------------------------------------------------------------------
*.cdd.tmp
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# ------------------------------------------------------------------------------
# Core Dumps & Crash Logs
